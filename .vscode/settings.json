{
  // Build output lives on exFAT, where an editor's file-watcher handle
  // blocks Next.js from recreating the directory. Keep every dist folder
  // out of watching, search and the explorer.
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/.next-dist/**": true,
    "**/.build/**": true,
    "**/.dist/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/.next-dist": true,
    "**/.build": true,
    "**/.dist": true
  },
  "files.exclude": {
    "**/.next": true,
    "**/.next-dist": true,
    "**/.build": true,
    "**/.dist": true
  }
}
