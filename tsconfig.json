{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-dist/types/**/*.ts",
    ".next-dist/dev/types/**/*.ts",
    ".build/types/**/*.ts",
    ".build/dev/types/**/*.ts",
    ".dist/types/**/*.ts",
    ".dist/dev/types/**/*.ts",
    ".dist2/types/**/*.ts",
    ".dist2/dev/types/**/*.ts",
    ".dist3/types/**/*.ts",
    ".dist3/dev/types/**/*.ts",
    ".dist4/types/**/*.ts",
    ".dist4/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-dist",
    ".build",
    ".dist",
    ".dist2",
    ".dist3",
    ".dist4"
  ]
}
